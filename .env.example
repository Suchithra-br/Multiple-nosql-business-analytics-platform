# ==============================================================================
# Multi-NoSQL Real-Time Business Analytics Platform - Environment Configuration
# ==============================================================================
# Copy this file to .env and configure with your local or cloud service credentials.
# DO NOT commit .env with real secrets to version control.

# ------------------------------------------------------------------------------
# Backend & API Configuration
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=True
API_TITLE="Multi-NoSQL Business Analytics API"
API_VERSION="1.0.0"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# ------------------------------------------------------------------------------
# MongoDB Configuration (Operational Document Store)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=business_analytics
MONGODB_COLLECTION_ORDERS=orders
MONGODB_COLLECTION_CUSTOMERS=customers
MONGODB_COLLECTION_PRODUCTS=products

# ------------------------------------------------------------------------------
# Redis Configuration (Real-Time KPI & Dashboard Cache)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_TTL=3600

# ------------------------------------------------------------------------------
# Apache Cassandra Configuration (Time-Series & Query-Driven Analytics)
# ------------------------------------------------------------------------------
CASSANDRA_HOSTS=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=business_analytics
CASSANDRA_REPLICATION_FACTOR=1
CASSANDRA_USERNAME=
CASSANDRA_PASSWORD=

# ------------------------------------------------------------------------------
# Neo4j Configuration (Graph & Relationship Analytics)
# ------------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# ------------------------------------------------------------------------------
# ETL Pipeline Configuration
# ------------------------------------------------------------------------------
DATASET_PATH=./data/train.csv
ETL_BATCH_SIZE=500
